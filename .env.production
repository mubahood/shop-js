# Production Environment Configuration
NODE_ENV=production

# BlitXpress Production Configuration  
VITE_APP_NAME=BlitXpress
VITE_APP_VERSION=v8.2.9
VITE_APP_API_URL=https://www.blit.blitxpress.com/api
VITE_APP_BASE_URL=https://www.blit.blitxpress.com
VITE_APP_CURRENCY=UGX

# Performance Settings
VITE_APP_ENABLE_ANALYTICS=true
VITE_APP_ENABLE_SERVICE_WORKER=true
VITE_APP_CACHE_VERSION=1.0.0

# Theme Configuration
VITE_APP_BASE_LAYOUT_CONFIG_KEY='blitxpress-react-demo1-8150'
VITE_APP_THEME_NAME=BlitXpress
VITE_APP_THEME_DEMO=demo1

# Production URLs
VITE_APP_PREVIEW_URL=https://shop.blitxpress.com
VITE_APP_CDN_URL=https://cdn.blitxpress.com